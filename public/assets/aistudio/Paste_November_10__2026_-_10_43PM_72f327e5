                const L = S.L; if (!L.deck.length) { b.innerHTML = '<div class="card" style="text-align:center"><div style="font-size:2.5rem">🎉</div><h3>Round finished</h3><p class="mu">Got it: <b>' + L.got + '</b> · Again: <b>' + L.again + '</b></p><div class="row" style="justify-content:center"><button class="p" id="lr">New round</button><button id="lg">Match game</button><button id="lpp">Go practise</button></div></div>'; $('#lr').onclick = () => { S.L.deck = null; cards() }; $('#lg').onclick = () => { S.L.m = 'match'; rLearn() }; $('#lpp').onclick = () => { S.mode = 'lesson'; go('practice') }; return }
