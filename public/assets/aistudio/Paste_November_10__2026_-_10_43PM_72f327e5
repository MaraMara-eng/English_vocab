            function authMode(m) { am = m; $$('#authSeg button').forEach(b => b.classList.toggle('on', b.dataset.m === m)); $('#aP2w').hidden = m !== 'up'; $('#aGo').textContent = m === 'in' ? 'Log in' : 'Create account'; $('#aP').autocomplete = m === 'in' ? 'current-password' : 'new-password'; $('#aErr').hidden = true }
            const aErr = m => { const e = $('#aErr'); e.textContent = m; e.hidden = !m };
