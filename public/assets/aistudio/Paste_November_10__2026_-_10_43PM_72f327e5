            /* ---------- manage (admin) ---------- */
            function splitLine(l) { const d = l.includes('|') ? '|' : l.includes('\t') ? '\t' : l.includes(';') ? ';' : ','; if (d === '|' || d === '\t') return l.split(d).map(x => x.trim()); const out = []; let cur = '', q = false; for (let i = 0; i < l.length; i++) { const c = l[i]; if (c === '"') { if (q && l[i + 1] === '"') { cur += '"'; i++ } else q = !q } else if (c === d && !q) { out.push(cur.trim()); cur = '' } else cur += c } out.push(cur.trim()); return out }
