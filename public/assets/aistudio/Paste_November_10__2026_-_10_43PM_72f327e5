                $('#abk').onclick = async () => { const n = $('#nbk').value.trim(); if (!n) { toast('Type a book name first'); return } const id = nk(n).replace(/\s+/g, '-').slice(0, 30) || 'book' + Date.now(); if (S.books.some(b => b.id === id || b.name.toLowerCase() === n.toLowerCase())) { toast('A book with this name exists'); return } S.books.push({ id, name: n }); try { await saveBooks(); toast('Book added'); await openBook(id); render() } catch (e) { S.books.pop(); toast('Could not save the book') } };
                el.onclick = async e => { const o = e.target.closest('[data-bo]'), d = e.target.closest('[data-bd]'); if (o) { await openBook(o.dataset.bo); render() } if (d && await ask('Delete this book and all its words?', 'Delete')) { const id = d.dataset.bd; S.books = S.books.filter(b => b.id !== id); await saveBooks(); await kv.del('bw', id); if (S.book === id) await openBook('bonk1'); render() } };
                $('#iL').onchange = e => $('#iNw').hidden = e.target.value !== '__new'; $('#iEx').onclick = () => { $('#iX').value = 'to look forward to | սպասել, ակնկալել | ждать с нетерпением | phrase | 12 | 3\nenough | բավարար | достаточно | word | 12 | 3\nI have been living here for five years. | Ես այստեղ ապրում եմ հինգ տարի։ | Я живу здесь пять лет. | sentence' };
