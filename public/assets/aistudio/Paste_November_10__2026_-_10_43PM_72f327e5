<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>Vocab Quest</title>
    <style>
        :root {
            --bg: #f4f5fb;
            --sf: #fff;
            --tx: #1b2140;
            --mu: #6b7194;
            --ln: #e3e6f3;
            --ac: #5b5bf0;
            --ac2: #14b8a6;
            --ok: #16a34a;
            --okb: #e3f8ea;
            --no: #dc2626;
            --nob: #fde8e8;
            --wn: #b45309;
            --wnb: #fff3d6;
            --sh: 0 8px 30px rgba(40, 50, 120, .08);
            box-sizing: border-box;
            padding-top: env(safe-area-inset-top, 0px);
            padding-bottom: env(safe-area-inset-bottom, 0px)
        }

        @media (prefers-color-scheme:dark) {
            :root:not([data-theme="light"]) {
                --bg: #0f1220;
                --sf: #181c33;
                --tx: #eceffd;
                --mu: #9aa1c8;
                --ln: #2a3050;
                --ac: #8b8bff;
                --ac2: #2dd4bf;
                --ok: #4ade80;
                --okb: #14301f;
                --no: #ff8a8a;
                --nob: #3b1a1c;
                --wn: #fbbf24;
                --wnb: #3a2f12;
                --sh: 0 8px 30px rgba(0, 0, 0, .35)
            }
        }

        :root[data-theme="dark"] {
            --bg: #0f1220;
            --sf: #181c33;
            --tx: #eceffd;
            --mu: #9aa1c8;
            --ln: #2a3050;
            --ac: #8b8bff;
            --ac2: #2dd4bf;
            --ok: #4ade80;
            --okb: #14301f;
            --no: #ff8a8a;
            --nob: #3b1a1c;
            --wn: #fbbf24;
            --wnb: #3a2f12;
            --sh: 0 8px 30px rgba(0, 0, 0, .35)
        }

        html {
            scroll-padding-top: env(safe-area-inset-top, 0px)
        }

        * {
            box-sizing: border-box
        }

        body {
            margin: 0;
            background: var(--bg);
            color: var(--tx);
            font: 16px/1.5 system-ui, -apple-system, "Segoe UI", "Noto Sans", "Noto Sans Armenian", Roboto, sans-serif;
            -webkit-font-smoothing: antialiased
        }

        [hidden] {
            display: none !important
        }

        button,
        input,
        select,
        textarea {
            font: inherit;
            color: inherit
        }

        button {
            cursor: pointer;
            border: 1px solid var(--ln);
            background: var(--sf);
            border-radius: 12px;
            padding: 9px 14px;
            transition: transform .08s, box-shadow .15s, background .15s
        }

        button:hover {
            box-shadow: var(--sh)
        }

        button:active {
            transform: scale(.97)
        }

        button.p {
            background: linear-gradient(135deg, var(--ac), var(--ac2));
            color: #fff;
            border: 0;
            font-weight: 600
        }

        button.g {
            background: transparent
        }

        button.d {
            color: var(--no)
        }

        button:disabled {
            opacity: .5;
            cursor: not-allowed
        }

        button.sm {
            padding: 5px 9px;
            border-radius: 9px;
            font-size: .85rem
        }

        input,
        select,
        textarea {
            background: var(--sf);
            border: 1px solid var(--ln);
            border-radius: 12px;
            padding: 9px 12px;
            max-width: 100%
        }

        input:focus-visible,
        select:focus-visible,
        textarea:focus-visible,
        button:focus-visible {
            outline: 2px solid var(--ac);
            outline-offset: 2px
        }

        textarea {
            width: 100%;
            min-height: 150px;
            font: 13px/1.5 ui-monospace, Menlo, Consolas, monospace
        }

        label.f {
            display: flex;
            flex-direction: column;
            gap: 4px;
            font-size: .8rem;
            color: var(--mu)
        }

        .card {
            background: var(--sf);
            border: 1px solid var(--ln);
            border-radius: 18px;
            padding: 18px;
            box-shadow: var(--sh);
            margin-bottom: 14px
        }

        .row {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            align-items: center
        }

        .row.sp {
            justify-content: space-between
        }

        .mu {
            color: var(--mu)
        }

        .sm {
            font-size: .85rem
        }

        .b {
            font-weight: 700
        }

        .chip {
            display: inline-block;
            padding: 2px 10px;
            border-radius: 99px;
            font-size: .75rem;
            background: color-mix(in srgb, var(--ac) 14%, transparent);
            color: var(--ac);
            font-weight: 600;
            margin-right: 4px
        }

        .chip.ok {
            background: var(--okb);
            color: var(--ok)
        }

        .chip.no {
            background: var(--nob);
            color: var(--no)
        }

        .chip.wn {
            background: var(--wnb);
            color: var(--wn)
        }

        .top {
            position: sticky;
            top: 0;
            z-index: 20;
            background: color-mix(in srgb, var(--bg) 88%, transparent);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--ln);
            padding: 10px 16px
        }

        .top .in {
            max-width: 1000px;
            margin: 0 auto;
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            align-items: flex-end
        }

        .brand {
            font-weight: 800;
            font-size: 1.2rem;
            background: linear-gradient(135deg, var(--ac), var(--ac2));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            align-self: center
        }

        .grow {
            flex: 1
        }

        .top select {
            min-width: 130px
        }

        .tabs {
            max-width: 1000px;
            margin: 14px auto 0;
            padding: 0 16px;
            display: flex;
            gap: 6px;
            overflow-x: auto
        }

        .tabs button {
            border-radius: 99px;
            white-space: nowrap
        }

        .tabs button.on {
            background: var(--ac);
            color: #fff;
            border-color: var(--ac)
        }

        main {
            max-width: 1000px;
            margin: 0 auto;
            padding: 14px 16px 60px
        }

        .seg {
            display: inline-flex;
            border: 1px solid var(--ln);
            border-radius: 12px;
            overflow: hidden
        }

        .seg button {
            border: 0;
            border-radius: 0;
            box-shadow: none
        }

        .seg button.on {
            background: var(--ac);
            color: #fff
        }

        .bar {
            height: 10px;
            background: var(--ln);
            border-radius: 99px;
            overflow: hidden
        }

        .bar i {
            display: block;
            height: 100%;
            background: linear-gradient(90deg, var(--ac2), var(--ok));
            transition: width .4s
        }

        .dots {
            display: inline-flex;
            gap: 4px
        }

        .dots i {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: var(--ln)
        }

        .dots i.on {
            background: var(--ok)
        }

        .q {
            font-size: 1.7rem;
            line-height: 1.3;
            font-weight: 700;
            margin: 8px 0 2px
        }

        .q2 {
            font-size: 1.15rem;
            color: var(--mu);
            margin: 0 0 14px
        }

        .ans {
            width: 100%;
            font-size: 1.2rem;
            padding: 13px 16px;
            border-radius: 14px
        }

        .fb {
            margin-top: 14px;
            padding: 14px;
            border-radius: 14px;
            border: 1px solid transparent
        }

        .fb.ok {
            background: var(--okb);
            border-color: var(--ok)
        }

        .fb.no {
            background: var(--nob);
            border-color: var(--no)
        }

        .fb.wn {
            background: var(--wnb);
            border-color: var(--wn)
        }

        .diff {
            font-size: 1.05rem;
            margin: 6px 0
        }

        .diff .bad {
            background: var(--nob);
            color: var(--no);
            border-radius: 6px;
            padding: 0 4px;
            text-decoration: underline wavy
        }

        .diff .del {
            text-decoration: line-through
        }

        .diff .good {
            background: var(--okb);
            color: var(--ok);
            border-radius: 6px;
            padding: 0 4px;
            font-weight: 700
        }

        .why {
            margin: 8px 0 0;
            padding-left: 20px
        }

        .why li {
            margin: 3px 0
        }

        .flash {
            perspective: 900px;
            height: 240px;
            margin: 10px 0
        }

        .flash .in {
            position: relative;
            width: 100%;
            height: 100%;
            transition: transform .5s;
            transform-style: preserve-3d;
            cursor: pointer
        }

        .flash.fl .in {
            transform: rotateY(180deg)
        }

        .flash .face {
            position: absolute;
            inset: 0;
            backface-visibility: hidden;
            border-radius: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 20px;
            border: 1px solid var(--ln);
            background: var(--sf);
            box-shadow: var(--sh)
        }

        .flash .back {
            transform: rotateY(180deg);
            background: linear-gradient(135deg, color-mix(in srgb, var(--ac) 16%, var(--sf)), color-mix(in srgb, var(--ac2) 16%, var(--sf)))
        }

        .pair {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px
        }

        .pair button {
            text-align: left;
            min-height: 48px
        }

        .pair button.sel {
            border-color: var(--ac);
            box-shadow: 0 0 0 2px var(--ac)
        }

        .pair button.done {
            background: var(--okb);
            border-color: var(--ok);
            opacity: .65
        }

        .pair button.bad {
            animation: sh .35s;
            border-color: var(--no)
        }

        @keyframes sh {
            25% {
                transform: translateX(-6px)
            }

            75% {
                transform: translateX(6px)
            }
        }

        .w {
            display: grid;
            grid-template-columns: 34px 1.3fr 1fr 1fr auto;
            gap: 10px;
            align-items: center;
            padding: 10px 4px;
            border-bottom: 1px solid var(--ln)
        }

        .w .mk {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            background: var(--ln);
            color: transparent;
            font-weight: 800
        }

        .w .mk.k {
            background: var(--ok);
            color: #fff
        }

        .w .acts {
            display: flex;
            gap: 4px
        }

        .w small {
            color: var(--mu)
        }

        @media (max-width:720px) {
            .w {
                grid-template-columns: 34px 1fr auto
            }

            .w .c3,
            .w .c4 {
                grid-column: 2/3
            }
        }

        .auth {
            max-width: 420px;
            margin: 8vh auto;
            padding: 0 16px
        }

        .auth h1 {
            margin: 0 0 4px
        }

        .auth .card {
            padding: 24px
        }

        .modal {
            position: fixed;
            inset: 0;
            background: rgba(10, 12, 30, .55);
            display: grid;
            place-items: center;
            z-index: 50;
            padding: 16px
        }

        .modal .box {
            background: var(--sf);
            border-radius: 20px;
            padding: 22px;
            max-width: 560px;
            width: 100%;
            max-height: 90vh;
            overflow: auto;
            box-shadow: var(--sh)
        }

        .toast {
            position: fixed;
            left: 50%;
            bottom: calc(20px + env(safe-area-inset-bottom, 0px));
            transform: translateX(-50%);
            background: var(--tx);
            color: var(--bg);
            padding: 10px 18px;
            border-radius: 99px;
            z-index: 60;
            font-size: .9rem;
            max-width: 90vw
        }

        .tbl {
            width: 100%;
            border-collapse: collapse;
            font-size: .85rem
        }

        .tbl td,
        .tbl th {
            padding: 5px 6px;
            border-bottom: 1px solid var(--ln);
            text-align: left;
            vertical-align: top
        }

        .tw {
            overflow-x: auto
        }

        .mic.rec {
            background: var(--no);
            color: #fff;
            animation: pl 1s infinite
        }

        @keyframes pl {
            50% {
                opacity: .6
            }
        }

        .stat {
            display: flex;
            gap: 18px;
            flex-wrap: wrap;
            margin: 10px 0 6px
        }

        .stat b {
            font-size: 1.3rem;
            display: block
        }

        .pop {
            animation: pop .4s
        }

        @keyframes pop {
            from {
                transform: scale(.9);
                opacity: 0
            }

            to {
                transform: none;
                opacity: 1
            }
        }
    </style>
</head>

<body>
    <div id="auth" class="auth" hidden>
        <div class="card">
            <h1>📖 Vocab Quest</h1>
            <p class="mu" style="margin-top:0">Practise vocabulary from your textbooks. Sign in to save your progress.
            </p>
            <div class="seg" id="authSeg"><button class="on" data-m="in">Log in</button><button data-m="up">Create
                    account</button></div>
            <div style="display:grid;gap:10px;margin-top:14px">
                <label class="f">Username<input id="aU" autocomplete="username" autocapitalize="off" spellcheck="false"
                        placeholder="e.g. anna"></label>
                <label class="f">Password<input id="aP" type="password" autocomplete="current-password"
                        placeholder="at least 4 characters"></label>
                <label class="f" id="aP2w" hidden>Repeat password<input id="aP2" type="password"
                        autocomplete="new-password"></label>
                <div id="aErr" class="chip no" hidden></div>
                <button class="p" id="aGo">Log in</button>
            </div>
            <p class="mu sm" id="aNote" style="margin-bottom:0"></p>
        </div>
    </div>

    <div id="app" hidden>
        <header class="top">
            <div class="in">
                <div class="brand">📖 Vocab Quest</div>
                <label class="f">Book<select id="bookSel"></select></label>
                <label class="f">Lesson<select id="lessonSel"></select></label>
                <label class="f grow">Search any word<input id="q" type="search"
                        placeholder="English, Armenian or Russian…"></label>
                <div class="row"><span class="chip" id="meName"></span><button class="sm" id="logout">Log out</button>
                </div>
            </div>
        </header>
        <nav class="tabs" id="tabs">
            <button data-t="learn">🎴 Learn</button><button data-t="practice" class="on">✍️ Practice</button><button
                data-t="words">📚 Words</button><button data-t="failed">🔁 Failed</button><button data-t="manage"
                id="tabManage">⚙️ Manage</button>
        </nav>
        <main>
            <section id="v-learn" hidden></section>
            <section id="v-practice"></section>
            <section id="v-words" hidden></section>
            <section id="v-failed" hidden></section>
            <section id="v-manage" hidden></section>
        </main>
    </div>
    <div id="modalHost"></div>
    <div class="toast" id="toast" hidden></div>

    <script>
        (function () {
            'use strict';
            const $ = (s, r = document) => r.querySelector(s), $$ = (s, r = document) => Array.from(r.querySelectorAll(s));
            const esc = s => String(s == null ? '' : s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
            const sleep = ms => new Promise(r => setTimeout(r, ms));
            const shuffle = a => { a = a.slice(); for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1));[a[i], a[j]] = [a[j], a[i]] } return a };

            /*PURE_START*/
            const nk = s => String(s || '').toLowerCase().replace(/[’‘`]/g, "'").replace(/[^a-z0-9'\s]/g, ' ').replace(/\s+/g, ' ').trim();
            const CONTR = { "i'm": "i am", "you're": "you are", "he's": "he is", "she's": "she is", "it's": "it is", "we're": "we are", "they're": "they are", "i've": "i have", "you've": "you have", "we've": "we have", "they've": "they have", "i'll": "i will", "you'll": "you will", "he'll": "he will", "she'll": "she will", "we'll": "we will", "they'll": "they will", "i'd": "i would", "you'd": "you would", "he'd": "he would", "we'd": "we would", "they'd": "they would", "don't": "do not", "doesn't": "does not", "didn't": "did not", "isn't": "is not", "aren't": "are not", "wasn't": "was not", "weren't": "were not", "haven't": "have not", "hasn't": "has not", "hadn't": "had not", "won't": "will not", "wouldn't": "would not", "can't": "can not", "cannot": "can not", "couldn't": "could not", "shouldn't": "should not", "mustn't": "must not", "needn't": "need not", "that's": "that is", "what's": "what is", "there's": "there is", "let's": "let us", "who's": "who is", "where's": "where is", "how's": "how is", "here's": "here is" };
            const PREP = new Set('at in on to for from of with by about into over under between among through across against along behind beside near off out up down after before during without within towards toward onto upon'.split(' '));
            const ART = new Set(['a', 'an', 'the']);
            function toks(s) { s = String(s || '').toLowerCase().replace(/[’‘`]/g, "'").replace(/[^a-z0-9'\s-]/g, ' ').replace(/-/g, ' '); return s.split(/\s+/).filter(Boolean).flatMap(t => { const e = CONTR[t]; return e ? e.split(' ') : [t.replace(/^'+|'+$/g, '')] }).filter(Boolean) }
            function lev(a, b) { const m = a.length, n = b.length; if (!m) return n; if (!n) return m; let p = [], c = [], i, j; for (j = 0; j <= n; j++)p[j] = j; for (i = 1; i <= m; i++) { c[0] = i; for (j = 1; j <= n; j++)c[j] = Math.min(p[j] + 1, c[j - 1] + 1, p[j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1));[p, c] = [c, p] } return p[n] }
            const spellish = (u, c) => c.length >= 4 && u.length >= 3 && lev(u, c) <= Math.max(1, Math.floor(c.length * .34));
            const PHS = new Set(['smth', 'smb', 'sth', 'sb', 'something', 'somebody']);
            function align(U, C) {
                const m = U.length, n = C.length, D = []; for (let i = 0; i <= m; i++) { D[i] = []; for (let j = 0; j <= n; j++)D[i][j] = i && j ? 0 : i + j }
                for (let i = 1; i <= m; i++)for (let j = 1; j <= n; j++) { const sub = U[i - 1] === C[j - 1] ? 0 : (spellish(U[i - 1], C[j - 1]) ? .6 : 1); D[i][j] = Math.min(D[i - 1][j] + 1, D[i][j - 1] + 1, D[i - 1][j - 1] + sub) }
                const ops = []; let i = m, j = n; while (i > 0 || j > 0) {
                    if (i && j) { const sub = U[i - 1] === C[j - 1] ? 0 : (spellish(U[i - 1], C[j - 1]) ? .6 : 1); if (Math.abs(D[i][j] - (D[i - 1][j - 1] + sub)) < 1e-9) { ops.push(sub === 0 ? { t: 'eq', u: U[i - 1], c: C[j - 1] } : { t: 'sub', u: U[i - 1], c: C[j - 1] }); i--; j--; continue } }
                    if (i && Math.abs(D[i][j] - (D[i - 1][j] + 1)) < 1e-9) { ops.push({ t: 'del', u: U[i - 1] }); i--; continue } ops.push({ t: 'ins', c: C[j - 1] }); j--
                }
                return ops.reverse()
            }
            function explain(U, C) {
                const ops = align(U, C), why = []; let spo = ops.some(o => o.t !== 'eq'); for (const o of ops) if (o.t !== 'eq' && !(o.t === 'sub' && (spellish(o.u, o.c) || o.c === o.u + 's' || o.u === o.c + 's' || o.c === o.u + 'es' || o.u === o.c + 'es'))) spo = false;
                const sameBag = U.length === C.length && U.slice().sort().join(' ') === C.slice().sort().join(' ');
                if (sameBag && U.join(' ') !== C.join(' ')) why.push('Right words, wrong order. Correct order: “' + C.join(' ') + '”.');
                else for (const o of ops) {
                    if (o.t === 'sub') {
                        if (o.c === o.u + 's' || o.u === o.c + 's' || o.c === o.u + 'es' || o.u === o.c + 'es') why.push('Word ending: write “' + o.c + '” (not “' + o.u + '”) — check the -s / singular–plural form.');
                        else if (spellish(o.u, o.c)) why.push('Spelling: “' + o.u + '” → “' + o.c + '”.');
                        else if (PREP.has(o.u) && PREP.has(o.c)) why.push('Preposition: use “' + o.c + '” instead of “' + o.u + '”.');
                        else if (ART.has(o.u) && ART.has(o.c)) why.push('Article: use “' + o.c + '” instead of “' + o.u + '”.');
                        else why.push('Wrong word: “' + o.u + '” should be “' + o.c + '”.')
                    }
                    else if (o.t === 'del') { why.push(ART.has(o.u) ? 'Extra article “' + o.u + '” — it isn’t used here.' : PREP.has(o.u) ? 'Extra preposition “' + o.u + '” — it isn’t needed here.' : 'Extra word “' + o.u + '” — remove it.') }
                    else if (o.t === 'ins') { why.push(ART.has(o.c) ? 'Missing article “' + o.c + '”.' : o.c === 'to' ? 'Missing “to” (the infinitive marker).' : PREP.has(o.c) ? 'Missing preposition “' + o.c + '”.' : 'Missing word “' + o.c + '”.') }
                }
                if (U.length && U.length < C.length * .6) why.push('Your answer is much shorter than expected — try to give the whole phrase.');
                const y = [], c2 = []; for (const o of ops) { if (o.t === 'eq') { y.push(esc(o.u)); c2.push(esc(o.c)) } else if (o.t === 'sub') { y.push('<span class="bad">' + esc(o.u) + '</span>'); c2.push('<span class="good">' + esc(o.c) + '</span>') } else if (o.t === 'del') y.push('<span class="bad del">' + esc(o.u) + '</span>'); else c2.push('<span class="good">' + esc(o.c) + '</span>') }
                return { why: why.slice(0, 6), you: y.join(' '), cor: c2.join(' '), spo }
            }
