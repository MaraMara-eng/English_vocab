                    + '<textarea id="iX" style="margin-top:10px" placeholder="to look forward to | սպասել, ակնկալել | ждать с нетерпением | phrase | 12 | 3"></textarea><div class="row" style="margin-top:8px"><label class="row sm mu"><input type="file" id="iF" accept=".txt,.csv,.tsv,text/plain"></label><button id="iEx">Insert example</button><button id="iPv">Preview</button><button class="p" id="iGo" disabled>Import</button></div><div id="iOut" style="margin-top:10px"></div></div>'
